{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipboard Preview",
  "version": "1.3.6",
  "identifier": "io.github.sirpaulcode.clipboardpreview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Clipboard Preview",
        "width": 940,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false,
        "create": false
      },
      {
        "label": "quick-preview",
        "title": "Clipboard Preview",
        "width": 480,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "create": false
      },
      {
        "label": "history-overlay",
        "title": "Clipboard Switcher",
        "width": 860,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Your clipboard, one hold away.",
    "longDescription": "A lightweight clipboard switcher with text and image previews for Windows, macOS, and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
